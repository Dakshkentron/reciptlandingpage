{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,

    /*
     * Matches how Vercel type-checks these functions, which is NOT how it
     * bundles them.
     *
     * This was "bundler" before, and the mismatch was silent and expensive:
     * `npm run typecheck` passed locally while every Vercel build printed
     * TS2835 on the same five imports, because Vercel runs its own check under
     * node16/nodenext and that resolution requires the `.js` extension on a
     * relative import. A check that disagrees with CI is worse than no check —
     * it hands you a clean result and lets the error through anyway.
     *
     * Keeping these aligned means the extensions stay right, and anyone who
     * removes one is told locally instead of finding out in a deploy log.
     */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Edge functions read configuration from process.env. */
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api"]
}
